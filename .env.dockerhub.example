NATS_URL=nats://nats-1:4222,nats://nats-2:4222,nats://nats-3:4222
NATS_JETSTREAM_REPLICAS=3

POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo_smtp

RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=6Le_34otAAAAAKt2gmK8RIR-amPBcRHgJxcDgw9F
RECAPTCHA_SECRET_KEY=6Le_34otAAAAANVEAaHJRRmYDbE5-Oy32cS36Dou

# Production CMIT (cần whitelist IP server → 172.16.84.91)
EMAIL_HOST=172.16.84.91
EMAIL_PORT=25
EMAIL_HOST_DOCKER=172.16.84.91
EMAIL_PORT_DOCKER=25
EMAIL_ENABLE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=eport@cmit.com.vn
EMAIL_FROM_NAME=CMIT Portal
EMAIL_ADMIN_NOTIFY=no-reply@cmit.com.vn

GATEWAY_PORT=7080
FRONTEND_PORT=5173
DEMO_GATEWAY=

DOCKER_NETWORK_DRIVER=nat
WINDOWS_BASE=mcr.microsoft.com/windows/servercore:ltsc2019
WINDOWS_ISOLATION=hyperv

# Jaeger/MailDev chạy host (Start-Platform-Host.ps1) — container trỏ host.docker.internal
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318

IMAGE_REGISTRY=docker.io
IMAGE_BASE=phuminh88/demo-smtp-win
IMAGE_TAG=demo
