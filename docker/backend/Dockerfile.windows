# escape=`
# Windows container — build from repo root (Switch to Windows containers trước).
#   docker build -f docker/backend/Dockerfile.windows --build-arg SERVICE=gateway -t backend-gateway .
ARG WINDOWS_BASE=node:20-windowsservercore-ltsc2022
ARG SERVICE=gateway

FROM ${WINDOWS_BASE} AS build
WORKDIR C:\app
COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY backend .\backend
COPY frontend .\frontend
RUN npm ci
RUN npm run build -w @demo/shared `
 && npm run build -w @demo/gateway `
 && npm run build -w @demo/recaptcha-service `
 && npm run build -w @demo/smtp-service

FROM ${WINDOWS_BASE} AS runtime
WORKDIR C:\app
ENV NODE_ENV=production
COPY --from=build C:\app\package.json C:\app\package-lock.json ./
COPY --from=build C:\app\node_modules .\node_modules
COPY --from=build C:\app\backend .\backend
ARG SERVICE=gateway
ENV SERVICE=${SERVICE}
WORKDIR C:\app\backend\${SERVICE}
EXPOSE 7080
CMD ["node", "dist/index.js"]
