# NATS JetStream cluster (docker/docker-compose.yml)
NATS_URL=nats://127.0.0.1:14222,nats://127.0.0.1:14223,nats://127.0.0.1:14224
NATS_JETSTREAM_REPLICAS=3

# Google reCAPTCHA v2 — test keys always pass (replace for real domains)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# SMTP — MailDev (docker) or Gmail App Password
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_ENABLE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=demo@localhost
EMAIL_FROM_NAME=Demo Portal

# Gateway HTTP
GATEWAY_PORT=7080
FRONTEND_PORT=5173
