# =============================================================================
# Local / Dev — MailDev + platform Docker group
# =============================================================================

# NATS — local host ports (npm run dev:*). Docker backend dùng hostname nats-1 nội bộ.
NATS_URL=nats://127.0.0.1:14222,nats://127.0.0.1:14223,nats://127.0.0.1:14224
NATS_JETSTREAM_REPLICAS=3

# PostgreSQL (platform group) — host ports
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo_smtp
DATABASE_URL=postgres://demo:demo@127.0.0.1:15432/demo_smtp

# Google reCAPTCHA v2 Checkbox — "CMIT - Customer Portal" (cùng cặp khoá cho Dev + Prod)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=6Le_34otAAAAAKt2gmK8RIR-amPBcRHgJxcDgw9F
RECAPTCHA_SECRET_KEY=6Le_34otAAAAANVEAaHJRRmYDbE5-Oy32cS36Dou

# SMTP — MailDev trên host. Trong Docker backend: EMAIL_HOST_DOCKER=maildev
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_DOCKER=maildev
EMAIL_PORT_DOCKER=1025
EMAIL_ENABLE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=demo@localhost
EMAIL_FROM_NAME=Demo Portal
EMAIL_ADMIN_NOTIFY=

GATEWAY_PORT=7080
FRONTEND_PORT=5173
DEMO_GATEWAY=

# Windows containers: nat | Linux engine: bridge
DOCKER_NETWORK_DRIVER=bridge
WINDOWS_BASE=node:20-windowsservercore-ltsc2022
WINDOWS_ISOLATION=process

# OpenTelemetry → Jaeger (platform group) UI http://127.0.0.1:16686
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
