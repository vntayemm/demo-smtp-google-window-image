# =============================================================================
# Local / Dev (MailDev) — xem .env.production.example cho CMIT SMTP relay
# =============================================================================

# NATS JetStream cluster (docker/docker-compose.yml)
NATS_URL=nats://127.0.0.1:14222,nats://127.0.0.1:14223,nats://127.0.0.1:14224
NATS_JETSTREAM_REPLICAS=3

# Google reCAPTCHA v2 Checkbox — "CMIT - Customer Portal" (cùng cặp khoá cho Dev + Prod)
# Domain phải khai trong Google Admin (localhost / host NGINX). Secret chỉ backend.
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=6Le_34otAAAAAKt2gmK8RIR-amPBcRHgJxcDgw9F
RECAPTCHA_SECRET_KEY=6Le_34otAAAAANVEAaHJRmYDbE5-Oy32cS36Dou

# SMTP — MailDev (docker)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_ENABLE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=demo@localhost
EMAIL_FROM_NAME=Demo Portal
EMAIL_ADMIN_NOTIFY=

# Gateway HTTP
GATEWAY_PORT=7080
FRONTEND_PORT=5173
