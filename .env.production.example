# =============================================================================
# Production / UAT — CMIT SMTP Relay (không AUTH)
# Nguồn: CMIT IT (Toan Nguyen) — SMTP relay nội bộ, whitelist IP app node.
# =============================================================================
#
# Cách dùng:
#   cp .env.production.example .env
#   # hoặc chỉ copy khối EMAIL_* vào .env hiện tại
#
# Tiền đề mạng:
#   - App node (máy chạy smtp-service / ServiceEmail) phải được whitelist
#     tới 172.16.84.91 (liên hệ Hiển / Minh / DevOps lấy IP gửi CMIT).
#   - Không set EMAIL_USERNAME / EMAIL_PASSWORD — relay không advertise AUTH.
#     (Windows container: env rỗng bị nuốt → appsettings/env file cũng phải rỗng.)
#
# Port: CMIT chưa nêu rõ trong chat — nội bộ thường 25. Nếu fail, thử 587
#       và xác nhận lại với CMIT IT.

NATS_URL=nats://127.0.0.1:14222,nats://127.0.0.1:14223,nats://127.0.0.1:14224
NATS_JETSTREAM_REPLICAS=3

# Google reCAPTCHA v2 Checkbox — "CMIT - Customer Portal" (cùng cặp khoá Dev + Prod)
# Site key → frontend; Secret key → recaptcha-service only. Domain whitelist trên Google Admin.
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=6Le_34otAAAAAKt2gmK8RIR-amPBcRHgJxcDgw9F
RECAPTCHA_SECRET_KEY=6Le_34otAAAAANVEAaHJRmYDbE5-Oy32cS36Dou

# --- CMIT SMTP Relay ---
EMAIL_HOST=172.16.84.91
EMAIL_PORT=25
# Khi chạy smtp-service trong Docker group backend:
EMAIL_HOST_DOCKER=172.16.84.91
EMAIL_PORT_DOCKER=25
EMAIL_ENABLE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Tài khoản gửi chính (portal / OTP / nghiệp vụ)
EMAIL_FROM_ADDRESS=eport@cmit.com.vn
EMAIL_FROM_NAME=CMIT Portal

# Chỉ gửi thông tin / notify (không dùng làm mailbox tương tác)
# Gắn vào luồng admin-notify khi có — smtp-service đọc EMAIL_ADMIN_NOTIFY
EMAIL_ADMIN_NOTIFY=no-reply@cmit.com.vn

GATEWAY_PORT=7080
FRONTEND_PORT=5173
DEMO_GATEWAY=

DOCKER_NETWORK_DRIVER=nat
WINDOWS_BASE=node:20-windowsservercore-ltsc2022
WINDOWS_ISOLATION=process

POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo_smtp

# OpenTelemetry → Jaeger
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
